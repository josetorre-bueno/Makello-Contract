# Cloudflare Pages cache rules
# HTML: never cache — always fetch fresh so version bumps propagate immediately.
# no-store also instructs Cloudflare's CDN layer not to cache (no-cache only
# controls browser caching).
/*.html
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-store
  CDN-Cache-Control: no-store

# JSX/JS: cache aggressively — filenames are versioned (or ?v= cache-busted from
# the HTML wrapper) so stale content is impossible.
/*.jsx
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# Docx templates and JSON defaults: short cache — these get replaced without a
# filename change. JSX fetches them with ?v= for immediate refresh on version
# bump; max-age=300 is the safety net for any direct browser load.
/*.docx
  Cache-Control: public, max-age=300

/*.json
  Cache-Control: public, max-age=300
